        "graph": {
          "requiredPaths": [
            [
              {
                "activityType": "s3.fetch"
              },
              {
                "activityType": "transform.flatten"
              },
              {
                "activityType": "transform.rename"
              },
              {
                "activityType": "sink.snowflake"
              }
            ]
          ]
        }
      }
