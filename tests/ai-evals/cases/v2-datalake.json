  "cases": [
    {
      "id": "lake-cdc-contract-iceberg",
      "category": "lake-generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": [
        "warehouse-read",
        "eval-iceberg"
      ],
      "request": {
        "prompt": "Continuously capture CDC changes from PostgreSQL connection warehouse-read table public.customers (syncMode cdc), enforce a data contract with schemaJson {\"type\":\"object\",\"required\":[\"id\",\"email\"]} quarantining violations, then write through Iceberg connection eval-iceberg to namespace lake table customers_silver."
      },
      "expect": {
        "activities": {
          "required": [
            "postgres.fetch",
            "transform.contract",
            "sink.iceberg"
          ],
          "forbidden": [
            "iceberg.fetch",
            "sink.postgres"
          ]
        },
        "configs": [
          {
            "activityType": "postgres.fetch",
            "contains": {
              "table": "public.customers",
              "syncMode": "cdc"
            }
          },
          {
            "activityType": "transform.contract",
            "contains": {
              "onViolation": "quarantine"
            }
          },
          {
            "activityType": "sink.iceberg",
            "contains": {
              "namespace": "lake",
              "table": "customers_silver"
            }
          }
        ],
        "graph": {
          "requiredPaths": [
            [
              {
                "activityType": "postgres.fetch"
              },
              {
                "activityType": "transform.contract"
              },
              {
                "activityType": "sink.iceberg"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "lake-silver-to-gold-clickhouse",
      "category": "lake-generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": [
        "eval-iceberg",
        "clickhouse-analytics"
      ],
      "request": {
        "prompt": "Read Iceberg connection eval-iceberg namespace lake table orders_silver, keep only rows where status equals completed, compute a revenue field as price * quantity, and load through ClickHouse connection clickhouse-analytics into table gold.daily_revenue as the gold layer."
      },
      "expect": {
        "activities": {
          "required": [
            "iceberg.fetch",
            "transform.filter",
            "transform.formula",
            "sink.clickhouse"
          ],
          "forbidden": [
            "sink.iceberg"
          ]
        },
        "configs": [
          {
            "activityType": "iceberg.fetch",
            "contains": {
              "namespace": "lake",
              "table": "orders_silver"
            }
          },
          {
            "activityType": "transform.formula",
            "contains": {
              "outputField": "revenue"
            }
          },
          {
            "activityType": "sink.clickhouse",
            "contains": {
              "table": "gold.daily_revenue",
              "layer": "gold"
            }
          }
        ],
        "graph": {
          "requiredPaths": [
            [
              {
                "activityType": "iceberg.fetch"
              },
              {
                "activityType": "transform.filter"
              },
              {
                "activityType": "transform.formula"
              },
              {
                "activityType": "sink.clickhouse"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "lake-join-orders-payments",
      "category": "lake-generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": [
        "warehouse-read",
        "reporting-mongo",
        "eval-iceberg"
      ],
      "request": {
        "prompt": "Read orders from PostgreSQL connection warehouse-read table public.orders and payments from MongoDB connection reporting-mongo collection payments, left join them on order_id, and write the result through Iceberg connection eval-iceberg to namespace lake table order_payments."
      },
      "expect": {
        "activities": {
          "required": [
            "postgres.fetch",
            "mongodb.fetch",
            "flow.merge",
            "sink.iceberg"
          ]
        },
        "configs": [
          {
            "activityType": "flow.merge",
            "contains": {
              "mergeStrategy": "leftJoin",
              "joinKey": "order_id"
            }
          },
          {
            "activityType": "mongodb.fetch",
            "contains": {
              "collection": "payments"
            }
          },
          {
            "activityType": "sink.iceberg",
            "contains": {
              "namespace": "lake",
              "table": "order_payments"
            }
          }
        ],
        "graph": {
          "minNodes": 4,
          "minInDegree": 2,
          "requiredPaths": [
            [
              {
                "activityType": "flow.merge"
              },
              {
                "activityType": "sink.iceberg"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "lake-s3-flatten-snowflake",
      "category": "lake-generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": [
        "eval-s3",
        "snowflake-analytics"
