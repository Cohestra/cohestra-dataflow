          "forbidden": [
            "sink.s3"
          ]
        },
        "configs": [
          {
            "activityType": "s3.fetch",
            "contains": {
              "bucket": "raw-zone",
              "key": "events/2026/10/15.jsonl",
              "format": "jsonl"
            }
          },
          {
            "activityType": "transform.flatten",
            "contains": {
              "delimiter": "_"
            }
          },
          {
            "activityType": "sink.snowflake",
            "contains": {
              "table": "ANALYTICS.EVENTS_SILVER"
            }
          }
