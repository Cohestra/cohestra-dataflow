    {
      "id": "lake-medallion-fork-zones",
      "category": "lake-generation",
      "endpoint": "/api/ai/generate",
      "connectorFixtures": [
        "eval-s3",
        "eval-iceberg",
        "clickhouse-analytics"
      ],
      "request": {
        "prompt": "Fetch https://api.example.test/telemetry and fork it into three zones: store the raw records through S3 connection eval-s3 in bucket lake-bronze key telemetry/raw.jsonl as bronze; deduplicate on device_id keeping the last record and write through Iceberg connection eval-iceberg to namespace lake table telemetry_silver as silver; and keep only rows where severity equals critical and send them through ClickHouse connection clickhouse-analytics to table gold.critical_alerts as gold."
      },
      "expect": {
        "activities": {
          "required": [
            "http.fetch",
            "flow.fork",
            "sink.s3",
            "transform.dedupe",
            "sink.iceberg",
            "transform.filter",
            "sink.clickhouse"
          ]
        },
        "configs": [
          {
            "activityType": "sink.s3",
            "contains": {
              "bucket": "lake-bronze",
              "key": "telemetry/raw.jsonl",
              "layer": "bronze"
            }
          },
          {
            "activityType": "transform.dedupe",
            "contains": {
              "key": "device_id",
              "keep": "last"
            }
          },
          {
            "activityType": "sink.iceberg",
            "contains": {
              "namespace": "lake",
              "table": "telemetry_silver"
            }
          },
          {
            "activityType": "sink.clickhouse",
            "contains": {
              "table": "gold.critical_alerts",
              "layer": "gold"
            }
          }
        ],
        "graph": {
          "minNodes": 7,
          "minOutDegree": 3,
          "requiredPaths": [
            [
              {
                "activityType": "transform.dedupe"
              },
              {
                "activityType": "sink.iceberg"
              }
            ],
            [
              {
                "activityType": "transform.filter"
              },
              {
                "activityType": "sink.clickhouse"
              }
            ]
          ]
        }
      }
    },
