    "version": "coded-catalog-v2",
    "nodeTypes": {
      "source": [
        "zendesk.fetch",
        "gsheets.fetch",
        "gdrive.fetch",
        "excel.fetch",
        "http.fetch",
        "postgres.fetch",
        "mysql.fetch",
        "mongodb.fetch",
        "s3.fetch",
        "kafka.fetch",
        "sftp.fetch",
        "snowflake.fetch",
        "iceberg.fetch"
