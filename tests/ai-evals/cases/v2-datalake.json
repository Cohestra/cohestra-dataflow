      ],
      "request": {
        "prompt": "Insert a dedupe on event_id keeping the last record between the Kafka source and the S3 sink. Leave all existing node settings unchanged.",
        "definition": {
          "trigger": {
            "type": "manual"
          },
          "nodes": [
            {
              "id": "src",
              "type": "source",
              "activityType": "kafka.fetch",
              "config": {
                "connectionId": "00000000-0000-4000-8000-000000000009",
                "topic": "clicks.raw",
                "layer": "bronze"
              }
            },
            {
              "id": "bronze",
              "type": "sink",
              "activityType": "sink.s3",
              "config": {
                "connectionId": "00000000-0000-4000-8000-000000000007",
                "bucket": "lake-bronze",
                "key": "clicks/raw.jsonl",
                "format": "jsonl",
                "layer": "bronze"
              }
            }
          ],
          "edges": [
            {
              "source": "src",
              "target": "bronze"
            }
          ]
        }
      },
      "expect": {
        "activities": {
          "required": [
            "kafka.fetch",
            "transform.dedupe",
            "sink.s3"
          ]
        },
        "configs": [
