      "request": {
        "prompt": "Ingest newline-delimited JSON from S3 connection eval-s3 bucket raw-zone key events/2026/10/15.jsonl, flatten nested fields with delimiter _, rename field usr_id to user_id, and load through Snowflake connection snowflake-analytics into table ANALYTICS.EVENTS_SILVER."
      },
      "expect": {
        "activities": {
          "required": [
            "s3.fetch",
            "transform.flatten",
            "transform.rename",
            "sink.snowflake"
