    {
      "id": "refine-lake-swap-sink-iceberg",
      "category": "lake-refinement",
      "endpoint": "/api/ai/refine",
      "connectorFixtures": [
        "warehouse-read",
        "eval-iceberg"
      ],
      "request": {
        "prompt": "Replace the S3 sink with an Iceberg sink through connection eval-iceberg to namespace lake table orders_silver. Keep the source and the filter exactly as they are.",
        "definition": {
          "trigger": {
            "type": "manual"
          },
          "nodes": [
            {
              "id": "orders",
              "type": "source",
              "activityType": "postgres.fetch",
              "config": {
                "connectionId": "00000000-0000-4000-8000-000000000001",
                "table": "public.orders"
              }
            },
            {
              "id": "completed",
              "type": "transform",
