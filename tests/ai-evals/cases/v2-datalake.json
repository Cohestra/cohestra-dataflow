            "activityType": "transform.dedupe",
            "contains": {
              "key": "event_id",
              "keep": "last"
            }
          }
        ],
        "preserve": {
          "nodes": [
            {
              "id": "src"
            },
            {
              "id": "bronze"
            }
          ]
        },
        "graph": {
          "requiredPaths": [
            [
