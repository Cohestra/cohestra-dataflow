      "transform": [
        "transform.map",
        "transform.filter",
        "transform.formula",
        "transform.select",
        "transform.rename",
        "transform.dedupe",
        "transform.flatten",
        "transform.parse",
        "transform.contract"
      ],
      "fork": [
        "flow.fork"
      ],
      "merge": [
        "flow.merge"
      ],
      "sink": [
        "sink.postgres",
        "sink.clickhouse",
        "sink.mysql",
        "sink.mongodb",
