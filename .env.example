# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=dataflow
DATAFLOW_APP_PASSWORD=dataflow_app
DATABASE_URL=postgres://dataflow:dataflow@localhost:5433/dataflow
APP_DATABASE_URL=postgres://dataflow_app:dataflow_app@localhost:5433/dataflow

# ── Temporal / Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=dynamic-dag

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-32-bytes-random-hex
JWT_SECRET_PREVIOUS=

# ── SMTP (use mailhog locally) ────────────────────────────────────────────────
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=465
SMTP_FROM=verified-sender@example.com
SMTP_USER=
SMTP_PASS=

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_PORT=4000

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Generic OIDC SSO (Okta, Azure AD, Auth0, Keycloak, etc.) ─────────────────
# Set OIDC_ISSUER to the IdP's issuer URL (no trailing slash).
# Examples: https://your-org.okta.com, https://login.microsoftonline.com/<tenant>/v2.0
# The discovery doc is fetched from {OIDC_ISSUER}/.well-known/openid-configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/api/auth/oidc/callback

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI=http://localhost:3000/api/connectors/microsoft/callback

# ── Zendesk ───────────────────────────────────────────────────────────────────
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_OAUTH_CLIENT_ID=
ZENDESK_OAUTH_CLIENT_SECRET=

# ── Google Service Account (connector) ───────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Billing (monthly execution quota + top-ups) is off unless this is true.
# Self-hosted installs should leave it off; usage is still counted.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OAuth token encryption (AES-256-GCM) ─────────────────────────────────────
# 32 random bytes, hex-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Temporal payload encryption (AES-256-GCM, defense-in-depth) ──────────────
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional: omit to run without Temporal payload encryption in dev.
TEMPORAL_PAYLOAD_ENCRYPTION_KEY=

# ── Large DataRef object storage (S3-compatible, optional) ───────────────────
# When set, payloads larger than 4 KiB use client-side encrypted object storage
# instead of Postgres. Leave access keys empty to use the AWS default credential chain.
PAYLOAD_S3_BUCKET=
PAYLOAD_S3_REGION=us-east-1
PAYLOAD_S3_ENDPOINT=
PAYLOAD_S3_FORCE_PATH_STYLE=false
PAYLOAD_S3_ACCESS_KEY_ID=
PAYLOAD_S3_SECRET_ACCESS_KEY=

# ── OpenLineage interoperability (optional) ──────────────────────────────────
# Base URL of Marquez or another OpenLineage backend. DataFlow appends /api/v1/lineage.
OPENLINEAGE_URL=
OPENLINEAGE_API_KEY=
OPENLINEAGE_NAMESPACE=dataflow

# ── Worker keypair (Phase 6 KMS) ─────────────────────────────────────────────
# Generate with: node scripts/gen-worker-keypair.js
# The script writes secrets/worker-keypair.pem (private) + secrets/worker-keypair.pub
# Copy the printed WORKER_PUBLIC_KEY_PEM line here.
WORKER_PUBLIC_KEY_PEM=

# ── Edition / demo ────────────────────────────────────────────────────────────
# Internal demos only: allows workspace owners to self-toggle paid features via PUT /api/edition/features/{feature}.
INTERNAL_DEMO_FEATURES=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Peers allowed to name the client in X-Real-IP (comma-separated CIDRs, or
# "none"). Empty trusts any loopback or private peer, which suits compose where
# only the web nginx reaches the API.
TRUSTED_PROXY_CIDRS=

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=dataflow
CLICKHOUSE_PASSWORD=dataflow
CLICKHOUSE_DB=dataflow
# Read-only user whose row filters return only the requesting tenant
# (db/clickhouse/users-analytics.xml). Leave the user empty to query as
# CLICKHOUSE_USER; the ClickHouse container reads the same password variable.
CLICKHOUSE_ANALYTICS_USER=dataflow_analytics
CLICKHOUSE_ANALYTICS_PASSWORD=dataflow-analytics

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Build ID (git SHA for worker versioning) ──────────────────────────────────
BUILD_ID=dev-local
