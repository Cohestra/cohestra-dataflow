    "react-dom": "^19.2.7",
    "react-grid-layout": "^1.4.4",
    "react-router": "^8.3.0",
    "reactflow": "^11.11.3",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.4.5",
    "vite": "^8.1.2"
  },
  "optionalDependencies": {
